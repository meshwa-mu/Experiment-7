
@model IEnumerable<Experiment_7.Models.Feedback>

@{
    ViewBag.Title = "Feedback List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Feedback Records</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<p>
    @Html.ActionLink("Add Feedback", "Create", "Feedback",
        null, new { @class = "btn btn-primary" })
</p>

@if (Model == null || !Model.Any())
{
    <p class="alert alert-info">No feedback submitted yet.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Enrollment</th>
                <th>Email</th>
                <th>Rating</th>
                <th>Comments</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.StudentName</td>
                    <td>@item.EnrollmentNo</td>
                    <td>@item.Email</td>
                    <td>@item.Rating / 5</td>
                    <td>@item.Comments</td>
                    <td>@item.SubmittedOn.ToString("dd-MM-yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}